# NexLink control server
PORT=4000
HOST=0.0.0.0
MONGODB_URI=mongodb://127.0.0.1:27017/nexus_rmc

# Leave empty to auto-generate a secret stored in DATA_DIR/jwt.secret
JWT_SECRET=
JWT_TTL_HOURS=12

# Where the server keeps generated secrets (and later WireGuard hub config)
DATA_DIR=./data

# Comma-separated origins allowed to call the API (Vite dev server + packaged Electron)
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

LOG_LEVEL=INFO

# Public address of this server (used for the Google redirect and agent enrollment)
# PUBLIC_URL=http://192.168.1.10:4000   (leave unset to auto-detect this PC's LAN address)

# Google sign-in (optional; can also be set in the app: Settings -> Sign-in). OAuth client type "Desktop app".
# (A "Web application" client is only needed for the browser dev build, with redirect URI:
#   http://localhost:4000/api/auth/google/callback )
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Let people create accounts themselves (they wait for admin approval)
ALLOW_REGISTRATION=true
